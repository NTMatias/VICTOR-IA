# Copia este archivo como .env. Configura solamente los servicios que utilices.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Opcional: restringir Spotify a un dispositivo concreto del PC.
SPOTIPY_DEVICE_ID=
# Ollama no necesita clave; instala Ollama y descarga un modelo por separado.

# Google OAuth: cliente de escritorio, independiente de Gemini.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Remoto HTTPS local; se activa manualmente desde Conectar.
REMOTE_PORT=8443
SCREEN_FPS=10
SCREEN_QUALITY=60
